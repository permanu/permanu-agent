   "expected": "[REDACTED]",
   "redacted": true
  },
  {
   "name": "pem_block_across_stream_lines",
   "rules": [
    "1"
   ],
   "kind": "stream",
   "input": [
    "starting worker",
    "-----BEGIN OPENSSH PRIVATE KEY-----",
    "b3BlbnNzaC1rZXktdjEAAAAAFAKEFAKE",
    "FAKEFAKEFAKEFAKE",
    "-----END OPENSSH PRIVATE KEY-----",
    "worker ready"
   ],
   "expected": [
    "starting worker",
    "[REDACTED]",
    "[REDACTED]",
    "[REDACTED]",
    "[REDACTED]",
    "worker ready"
   ],
   "redacted": true
  },
