{
 "version": "redaction-v1",
 "description": "Normative vectors for redaction-v1 (agent-protocol.md section 9.6). Every secret here is FAKE (the word FAKE is part of each value) and none is valid anywhere. kind: string (rules 1-7 on one string), fields (rule 8 on a map; other values get rules 1-7), stream (rule 1 across the lines of one container stream). redacted is true exactly when the output differs from the input. Checker: contracts/tools/redaction_vectors.py.",
 "replacement": "[REDACTED]",
 "cases": [
  {
   "name": "pem_block_in_one_string",
   "rules": [
    "1"
   ],
   "kind": "string",
   "input": "loaded key: -----BEGIN PRIVATE KEY-----\nMIIEFAKEFAKEFAKE\nFAKEFAKE==\n-----END PRIVATE KEY----- ok",
   "expected": "loaded key: [REDACTED] ok",
   "redacted": true
  },
